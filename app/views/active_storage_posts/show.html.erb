<div class="uc-page-header">
  <h1>Active Storage post "<%= @active_storage_post.title %>"</h1>
  <div class="uc-action-group">
    <%= link_to "Edit", edit_active_storage_post_path(@active_storage_post), class: "uc-button uc-button-secondary" %>
    <%= button_to "Delete", active_storage_post_path(@active_storage_post), method: :delete, class: "uc-button uc-button-danger", form_class: "inline-block" %>
  </div>
</div>

<h4 class="flex items-center justify-between mt-5">
  Cover image
</h4>
<% if @active_storage_post.cover_image.attached? %>
  <% attachment = @active_storage_post.cover_image %>
  <li class="uc-list-item uc-list-item-actions">
    <div class="uc-list-main">
      <%= link_to attachment.filename.to_s, rails_blob_path(attachment, disposition: "attachment") %>
      <br>
      <div class="uc-badge uc-badge-secondary"><%= attachment.content_type %></div>
      <div class="uc-badge uc-badge-secondary"><%= number_to_human_size(attachment.byte_size) %></div>
      <div class="uc-badge uc-badge-secondary"><%= attachment.blob.service_name %></div>
    </div>
  </li>
<% else %>
  --
<% end %>

<h4 class="flex items-center justify-between mt-4">
  Attachments
</h4>
<% if @active_storage_post.attachments.attached? %>
  <% @active_storage_post.attachments.each do |attachment| %>
    <li class="uc-list-item uc-list-item-actions">
      <div class="uc-list-main">
        <%= link_to attachment.filename.to_s, rails_blob_path(attachment, disposition: "attachment") %>
        <br>
        <div class="uc-badge uc-badge-secondary"><%= attachment.content_type %></div>
        <div class="uc-badge uc-badge-secondary"><%= number_to_human_size(attachment.byte_size) %></div>
        <div class="uc-badge uc-badge-secondary"><%= attachment.blob.service_name %></div>
      </div>
    </li>
  <% end %>
<% else %>
  --
<% end %>
