<h1>Comments</h1>

  <% if @comments.present? %>
    <ul class="uc-list">
      <% @comments.each do |comment| %>
        <li class="uc-list-item uc-list-item-actions">
          <div class="uc-list-main">
            <%= link_to comment.content, comment_path(comment) %>
          </div>
          <div class="uc-action-group" role="group" aria-label="Actions">
            <%= link_to 'Edit', edit_comment_path(comment), class: "uc-button uc-button-sm uc-button-secondary" %>
            <%= button_to 'Delete', comment_path(comment), method: :delete, class: "uc-button uc-button-sm uc-button-danger", form_class: "inline-block" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <span>No comments found. Please, create a one <%= link_to 'here', new_comment_path, class: 'inline-block' %>!</span>
  <% end %>
