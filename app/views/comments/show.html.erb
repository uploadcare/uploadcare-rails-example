<div class="uc-page-header">
  <h1>Comment "<%= @comment.content %>"</h1>
  <div class="uc-action-group">
    <%= link_to 'Edit', edit_comment_path(@comment), class: "uc-button uc-button-secondary" %>
    <%= button_to 'Delete', comment_path(@comment), method: :delete, class: "uc-button uc-button-danger", form_class: "inline-block" %>
  </div>
</div>

<h4 class="flex items-center justify-between mt-5">
  Image
</h4>
<% if @comment.image? %>
  <li class="uc-list-item uc-list-item-actions">
    <div class="uc-list-main">
      <%= link_to @comment.image.load.original_filename, file_path(@comment.image.uuid) %>
      <br>
      <div class="uc-badge uc-badge-secondary"><%= @comment.image.uuid %></div>
      <div class="uc-badge uc-badge-secondary"><%= @comment.image.mime_type %></div>
    </div>
    <div class="uc-action-group" role="group" aria-label="Actions">
      <%= button_to 'Copy', copy_file_path(@comment.image.uuid), method: :post, class: "uc-button uc-button-sm uc-button-secondary", form_class: "inline-block" %>
      <%= button_to 'Store', store_file_path(@comment.image.uuid), method: :post, class: "uc-button uc-button-sm uc-button-secondary", form_class: "inline-block" %>
      <%= button_to 'Delete', file_path(@comment.image.uuid), method: :delete, class: "uc-button uc-button-sm uc-button-danger", form_class: "inline-block" %>
    </div>
  </li>
<% else %>
  --
<% end %>

<h4 class="flex items-center justify-between mt-4">
  Attachments
</h4>
<% if @attachments.present? %>
  <% @attachments.each do |file| %>
    <li class="uc-list-item uc-list-item-actions">
      <div class="uc-list-main">
        <%= link_to file.original_filename, file_path(file.uuid) %>
        <br>
        <div class="uc-badge uc-badge-secondary"><%= file.uuid %></div>
        <div class="uc-badge uc-badge-secondary"><%= file.mime_type %></div>
      </div>
      <div class="uc-action-group" role="group" aria-label="Actions">
        <%= button_to 'Copy', copy_file_path(file.uuid), method: :post, class: "uc-button uc-button-sm uc-button-secondary", form_class: "inline-block" %>
        <%= button_to 'Store', store_file_path(file.uuid), method: :post, class: "uc-button uc-button-sm uc-button-secondary", form_class: "inline-block" %>
        <%= button_to 'Delete', file_path(file.uuid), method: :delete, class: "uc-button uc-button-sm uc-button-danger", form_class: "inline-block" %>
      </div>
    </li>
  <% end %>
<% else %>
  --
<% end %>
