<h1>Conversion formats info</h1>

<div class="uc-card">
  <div class="uc-card-body">
    <%= form_tag(document_conversion_information_path, method: :get, class: "p-1") do %>
      <div class="mb-3">
        <label class="uc-label" for="file">File</label>
        <%= select_tag(:file, options_from_collection_for_select(@files, :uuid, :original_filename), class: "uc-input") %>
      </div>
      <%= submit_tag "Get Conversion Formats", class: "uc-button uc-button-primary", name: "" %>
    <% end %>
  </div>
</div>
