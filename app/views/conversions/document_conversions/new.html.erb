<h1>Document conversion</h1>

  <div class="uc-card">
    <div class="uc-card-body">
      <%= form_tag(document_conversions_path, method: :post, class: 'p-1') do %>
        <div class="mb-3">
          <label class="uc-label" for="file">File</label>
          <%= select_tag(:file, options_from_collection_for_select(@files, :uuid, :original_filename, params[:file]), class: 'uc-input') %>
        </div>

        <div class="mb-3">
          <label class="uc-label" for="target_format">Target format</label>
          <% if params[:target_format].present? %>
            <%= select_tag(:target_format, options_for_select([params[:target_format]], params[:target_format]), class: 'uc-input') %>
          <% else %>
            <%= select_tag(:target_format, options_for_select(document_target_formats), class: 'uc-input') %>
          <% end %>
        </div>

        <div class="mb-3">
          <label class="uc-label" for="page">Page</label>
          <%= number_field_tag 'page', nil, class: 'uc-input' %>
        </div>

        <div class="mb-3">
          <%= check_box_tag 'save_in_group', 1, false %>
          <label class="uc-label" for="throw_error">Save in group</label>
        </div>

        <div class="mb-3">
          <%= check_box_tag 'throw_error', true, false %>
          <label class="uc-label" for="throw_error">Throw error</label>
        </div>

        <div class="mb-4">
          <label class="uc-label" for="store">Store</label>
          <%= select_tag(:store, options_for_select(store_options), class: 'uc-input') %>
        </div>

        <%= submit_tag 'Convert', class: 'uc-button uc-button-primary' %>
      <% end %>
    </div>
  </div>
