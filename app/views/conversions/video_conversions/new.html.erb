<h1>Video conversion</h1>

  <div class="uc-card">
    <div class="uc-card-body">
      <%= form_tag(video_conversions_path, method: :post, class: 'p-1') do %>
        <div class="mb-3">
          <label class="uc-label" for="file">File</label>
          <%= select_tag(:file, options_from_collection_for_select(@files, :uuid, :original_filename), class: 'uc-input') %>
        </div>

        <div class="mb-3">
          <label class="uc-label" for="target_format">Target format</label>
          <%= select_tag(:target_format, options_for_select(video_arget_formats), class: 'uc-input', include_blank: true) %>
        </div>

        <div class="mb-3">
          <label class="uc-label" for="target_format">Quality</label>
          <%= select_tag(:quality, options_for_select(video_qualities), class: 'uc-input', include_blank: true) %>
        </div>

        <div class="mb-3">
          <label class="uc-label" for="page">Size</label>
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
            <div>
              <label class="uc-label" for="resize_mode">Resize mode</label>
              <%= select_tag(:resize_mode, options_for_select(video_resize_modes), name: 'size[resize_mode]', class: 'uc-input', include_blank: true) %>
            </div>
            <div>
              <label class="uc-label" for="width">Width</label>
              <%= number_field_tag :width, nil, name: 'size[width]', class: 'uc-input' %>
              <p class="mt-1 text-xs text-zinc-500">must be divisible by 4</p>
            </div>
            <div>
              <label class="uc-label" for="height">Height</label>
              <%= number_field_tag :height, nil, name: 'size[height]', class: 'uc-input' %>
              <p class="mt-1 text-xs text-zinc-500">must be divisible by 4</p>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="uc-label" for="page">Cut</label>
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <div>
              <label class="uc-label" for="width">Start time</label>
              <%= text_field_tag :start_time, nil, name: 'cut[start_time]', class: 'uc-input', placeholder: '0:0:0.0' %>
            </div>
            <div>
              <label class="uc-label" for="height">Length</label>
              <%= text_field_tag :length, nil, name: 'cut[length]', class: 'uc-input', placeholder: '0:0:1.0 OR end' %>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="uc-label" for="page">Thumbs</label>
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <div>
              <label class="uc-label" for="width">N</label>
              <%= number_field_tag :N, nil, name: 'thumbs[n]', class: 'uc-input' %>
            </div>
            <div>
              <label class="uc-label" for="height">Number</label>
              <%= number_field_tag :length, nil, name: 'thumbs[number]', class: 'uc-input' %>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <%= check_box_tag 'throw_error', true, false %>
          <label class="uc-label" for="throw_error">Throw error</label>
        </div>

        <div class="mb-4">
          <label class="uc-label" for="store">Store</label>
          <%= select_tag(:store, options_for_select(store_options), class: 'uc-input') %>
        </div>

        <%= submit_tag 'Convert', class: 'uc-button uc-button-primary' %>
      <% end %>
    </div>
  </div>
