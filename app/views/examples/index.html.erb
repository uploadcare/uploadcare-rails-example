<h1>Examples</h1>
<p class="text-sm text-zinc-500">Feature coverage grouped by practical Uploadcare workflows.</p>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
  <% @example_groups.each do |group| %>
    <div>
      <div class="uc-card h-full">
        <div class="uc-card-body">
          <h2 class="uc-card-title"><%= group[:title] %></h2>
          <ul class="mt-3 space-y-2 text-sm">
            <% group[:links].each do |label, path| %>
              <li><%= link_to label, path %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>
</div>
