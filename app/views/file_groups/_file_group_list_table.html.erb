<div class="uc-card">
  <div class="uc-card-body">
    <h5 class="uc-card-title">Total groups: <%= file_groups_count %></h5>
  </div>
  <% if file_groups.blank? %>
    <div class="uc-card-body">
      <h5 class="uc-card-title">
        You have no groups in your project. Create a new one <%= link_to 'here', new_file_group_path %>!
      </h5>
    </div>
  <% else %>
    <ul class="uc-list">
      <% file_groups.each do |file_group| %>
        <li class="uc-list-item uc-list-item-actions">
          <div class="uc-list-main">
            <%= link_to file_group.id, file_group_path(file_group.id) %>
          </div>
          <div class="uc-badge uc-badge-secondary"><%= file_group.files_count %> files</div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
