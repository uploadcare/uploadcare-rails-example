<h3>uuid: <%= @uuid %></h3>

<div class="uc-card">
  <div class="uc-card-body">
    <%= @metadata %>
  </div>

  <div class="border">
    <%= form_tag(metadata_show_file_metadata_path, method: :get, class: 'uc-form-panel') do %>
      <%= hidden_field_tag :uuid, @uuid %>
      <div class="mb-2">
        <label class="uc-label" for="key">select key</label>
        <%= select_tag(:key, options_for_select(@metadata.keys), class: 'uc-input') %>
      </div>
      <%= hidden_field_tag :keys, @metadata.values %>
      <%= submit_tag 'Show metadata by key', class: 'uc-button uc-button-primary' %>
    <% end %>
  </div>

  <div class="border">
    <%= form_tag(metadata_update_file_metadata_path, method: :patch, class: 'uc-form-panel') do %>
      <%= hidden_field_tag :uuid, @uuid %>
      <div class="mb-2">
        <label class="uc-label" for="key">select key</label>
        <%= select_tag(:key, options_for_select(@metadata.keys), class: 'uc-input') %>
      </div>
      <div class="mb-2">
        <label class="uc-label" for="value">set value</label>
        <%= text_field_tag :value, nil, class: 'uc-input' %>
      </div>
      <%= submit_tag 'Update metadata by key', class: 'uc-button uc-button-primary' %>
    <% end %>
  </div>

  <div class="border">
    <%= form_tag(metadata_update_file_metadata_path, method: :patch, class: 'uc-form-panel') do %>
      <%= hidden_field_tag :uuid, @uuid %>
      <div class="mb-2">
        <label class="uc-label" for="key">select key</label>
        <%= text_field_tag :key, nil, class: 'uc-input' %>
      </div>
      <div class="mb-2">
        <label class="uc-label" for="value">set value</label>
        <%= text_field_tag :value, nil, class: 'uc-input' %>
      </div>
      <%= submit_tag 'Create metadata', class: 'uc-button uc-button-primary' %>
    <% end %>
  </div>

  <div class="border">
    <%= form_tag(metadata_delete_file_metadata_path, method: :delete, class: 'uc-form-panel') do %>
      <%= hidden_field_tag :uuid, @uuid %>
      <div class="mb-2">
        <label class="uc-label" for="key">select key</label>
        <%= select_tag(:key, options_for_select(@metadata.keys), class: 'uc-input') %>
      </div>
      <%= submit_tag 'Delete metadata by key', class: 'uc-button uc-button-primary' %>
    <% end %>
  </div>
</div>
