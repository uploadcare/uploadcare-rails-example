<h1>Select file</h1>

<div class="uc-card">
  <div class="uc-card-body">
    <%= form_tag(all_metadata_show_file_metadata_path, method: :get, class: 'p-1') do %>
      <div class="mb-3">
        <label class="uc-label" for="uuid">File</label>
        <%= select_tag(:uuid, options_from_collection_for_select(@files, :uuid, :original_filename), class: 'uc-input') %>
      </div>

      <%= submit_tag 'Show all metadata', class: 'uc-button uc-button-primary' %>
    <% end %>
  </div>
</div>
