<div class="uc-card">
  <div class="uc-card-body">
    <h5 class="uc-card-title">Total files: <%= files_count %></h5>
  </div>
  <% if files.blank? %>
    <div class="uc-card-body">
      <h5 class="uc-card-title">
        You have no files in your project. <%= link_to 'Upload a file', upload_new_local_file_path %>.
      </h5>
    </div>
  <% end %>
  <ul class="uc-list">
    <% files.each do |file| %>
      <li class="uc-list-item uc-list-item-actions">
        <div class="uc-list-main">
          <%= link_to file.original_filename, file_path(file.uuid) %>
          <br>
          <div class="uc-badge uc-badge-secondary"><%= file.uuid %></div>
          <div class="uc-badge uc-badge-secondary"><%= file.mime_type %></div>
        </div>
        <div class="uc-action-group" role="group" aria-label="Actions">
          <%= button_to 'Copy', copy_file_path(file.uuid), method: :post, class: "uc-button uc-button-sm uc-button-secondary", form_class: "inline-block" %>
          <%= button_to 'Store', store_file_path(file.uuid), method: :post, class: "uc-button uc-button-sm uc-button-secondary", form_class: "inline-block" %>
          <%= button_to 'Delete', file_path(file.uuid), method: :delete, class: "uc-button uc-button-sm uc-button-danger", form_class: "inline-block" %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
