<span class="h1 text-truncate d-block mb-2">File <%= @file.original_filename %> info</span>
  <%= link_to 'Back', request.referer == request.url ? files_path : request.referer %>
  <hr>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h4>Remote file</h4>
    <div class="d-flex flex-wrap gap-1">
      <%= button_to 'Copy', copy_file_path(@file.uuid), method: :post, class: "btn btn-secondary", form_class: "d-inline" %>
      <%= button_to 'Store', store_file_path(@file.uuid), method: :post, class: "btn btn-secondary", form_class: "d-inline" %>
    </div>
  </div>
  <div class="table-responsive">
    <%= render 'files/file_info', file: @file, date_format: '%B %d, %Y %H:%M' %>
  </div>

  <% if @file.content_info&.dig("image").present? || @file.content_info&.dig(:image).present? %>
    <%= render 'files/image_info', image_info: (@file.content_info["image"] || @file.content_info[:image]) %>
  <% end %>

  <% if @file.content_info&.dig("video").present? || @file.content_info&.dig(:video).present? %>
    <%= render 'files/video_info', video_info: (@file.content_info["video"] || @file.content_info[:video]) %>
  <% end %>
  <%= button_to 'Delete file', file_path(@file.uuid), method: :delete, class: "btn btn-danger", form_class: "d-inline" %>
