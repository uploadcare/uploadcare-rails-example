<% flash.each do |key, value| %>
  <% if value.is_a? Array %>
    <% value.each do |element| %>
      <div class="<%= flash_class(key) || "uc-alert uc-alert-neutral" %>" role="alert">
        <%= element %>
      </div>
    <% end %>
  <% else %>
    <div class="<%= flash_class(key) || "uc-alert uc-alert-neutral" %>" role="alert">
      <%= value %>
    </div>
  <% end %>
<% end %>
