<!DOCTYPE html>
<html>
  <head>
    <title>UploadcareRailsExample</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= uploadcare_include_tag min: true %>
  </head>

  <body class="min-h-screen bg-zinc-50 text-zinc-900 antialiased">
    <nav class="border-b border-zinc-200 bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        <a class="text-base font-semibold text-zinc-950 no-underline hover:text-zinc-700" href="https://uploadcare.com" target="_blank" rel="noreferrer">Uploadcare</a>
      </div>
    </nav>

    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-4 py-6 sm:px-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:px-8">
      <aside class="order-2 lg:order-1">
        <%= render 'layouts/menu' %>
      </aside>
      <main class="order-1 min-w-0 lg:order-2">
        <div class="space-y-5">
          <%= render 'layouts/flash', flash: flash, allowed_keys: ApplicationHelper::FLASH.keys %>
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
