<h1>Posts</h1>

  <% if @posts.present? %>
    <ul class="uc-list">
      <% @posts.each do |post| %>
        <li class="uc-list-item uc-list-item-actions">
          <div class="uc-list-main">
            <%= link_to short_title(post), post_path(post) %>
          </div>
          <div class="uc-action-group" role="group" aria-label="Actions">
            <%= link_to 'Edit', edit_post_path(post), class: "uc-button uc-button-sm uc-button-secondary" %>
            <%= button_to 'Delete', post_path(post), method: :delete, class: "uc-button uc-button-sm uc-button-danger", form_class: "inline-block" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <span>No posts found. Please, create a one <%= link_to 'here', new_post_path, class: 'inline-block' %>!</span>
  <% end %>
