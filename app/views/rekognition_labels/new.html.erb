<h1>Rekognition file labels</h1>

<div class="uc-card">
  <div class="uc-card-body">
    <%= form_tag(rekognition_labels_path, method: :post, class: 'p-1') do %>
      <div class="mb-3">
        <label class="uc-label" for="file">File</label>
        <%= select_tag(:file, options_from_collection_for_select(@files, :uuid, :original_filename), class: 'uc-input') %>
      </div>

      <%= submit_tag 'Check', class: 'uc-button uc-button-primary' %>
    <% end %>
  </div>
</div>
