<h1>Remove file background</h1>

<div class="uc-card">
  <div class="uc-card-body">
    <%= form_tag(remove_bg_index_path, method: :post, class: 'p-1') do %>
      <div class="mb-3">
        <label class="uc-label" for="file">File</label>
        <%= select_tag(:file, options_from_collection_for_select(@files, :uuid, :original_filename), class: 'uc-input') %>
      </div>

      <div class="mb-3">
        <label class="uc-label" for="page">Options</label>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <div class="flex items-center gap-2 pt-7">
              <%= check_box_tag :crop, true, false, name: 'options[crop]' %>
              <label class="text-sm font-medium text-zinc-700" for="crop">crop</label>
            </div>
          </div>
          <div>
            <label class="uc-label" for="crop_margin">crop margin</label>
            <%= text_field_tag :crop_margin, nil, name: 'options[crop_margin]', class: 'uc-input', placeholder: '30px or 30%' %>
          </div>
          <div>
            <label class="uc-label" for="height">scale</label>
            <%= text_field_tag :scale, nil, name: 'options[scale]', class: 'uc-input', placeholder: '50%' %>
          </div>
          <div>
            <label class="uc-label" for="height">type level</label>
            <%= text_field_tag :type_level, nil, name: 'options[type_level]', class: 'uc-input' %>
            <p class="mt-1 text-xs text-zinc-500">allowed values: none, 1, 2, latest</p>
          </div>
        </div>
      </div>

      <%= submit_tag 'Check', class: 'uc-button uc-button-primary' %>
    <% end %>
  </div>
</div>
