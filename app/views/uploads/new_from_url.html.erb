<h1>Upload a file from URL</h1>

<%= form_tag(upload_file_from_url_path, method: :post, class: 'uc-form-panel', multipart: true) do %>
  <div>
    <div class="upload-file">
      <div class="mb-3">
        <label class="uc-label" for="">File URL</label>
        <input type="text" class="uc-input" id="file_url" name="file[url]">
      </div>

      <div class="mb-3">
        <label class="uc-label" for="filename">Filename</label>
        <input type="text" class="uc-input" id="filename" name="file[filename]">
      </div>
    </div>

    <div>
      <label class="uc-label" for="store">Store</label>
      <%= select_tag(:store, options_for_select(store_options), class: 'uc-input', name: 'file[store]') %>
    </div>
  </div>

  <%= submit_tag 'Upload file', class: 'uc-button uc-button-primary mt-4' %>
<% end %>
