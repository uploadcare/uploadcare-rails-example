<h3>uuid: <%= @uuid %></h3>

<div class="uc-card">
  <div class="uc-card-body">
    <%= form_tag(check_status_virus_scan_index_path, method: :get, class: 'uc-form-panel') do %>
      <%= hidden_field_tag :uuid, @uuid %>
      <%= submit_tag 'Check status', class: 'uc-button uc-button-primary' %>
    <% end %>
  </div>
</div>
