<h1>Webhooks list</h1>

<ul class="uc-list">
  <% @webhooks.each do |webhook| %>
    <li class="uc-list-item uc-list-item-actions">
      <div class="flex-1">
        <%= link_to webhook.id, webhook_path(webhook.id), class: 'uc-badge uc-badge-info' %>
        <code><%= webhook.target_url %></code> from <%= format_date(webhook.created, format: '%B, %e, %Y %H:%M') %> (<%= webhook.is_active ? 'Active' : 'Not active' %>)
      </div>
      <div class="uc-action-group" role="group" aria-label="Actions">
        <%= link_to 'Edit', edit_webhook_path(webhook.id), class: 'uc-button uc-button-sm uc-button-secondary' %>
        <%= button_to 'Delete', delete_webhook_path(target_url: webhook.target_url), method: :delete, class: 'uc-button uc-button-sm uc-button-danger', form_class: "inline-block" %>
      </div>
    </li>
  <% end %>
</ul>
