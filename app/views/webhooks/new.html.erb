<h1>Create a new webhook</h1>

<div class="uc-card">
  <div class="uc-card-body">
  <%= form_tag(webhooks_path, method: :post, class: "p-1") do %>
    <div class="mb-3">
      <label class="uc-label" for="file">Target URL</label>
      <%= text_field_tag :target_url, nil, name: "webhook[target_url]", class: "uc-input" %>
    </div>

    <div class="mb-3">
      <label class="uc-label" for="event">Event</label>
      <%= select_tag(:event, options_for_select(webhook_events, "file.uploaded"), name: "webhook[event]", class: "uc-input") %>
    </div>

    <div class="mb-3">
      <%= check_box_tag "is_active", true, true, name: "webhook[is_active]" %>
      <label class="uc-label" for="is_active">Enabled</label>
    </div>

    <%= submit_tag "Create", class: "uc-button uc-button-primary" %>
  <% end %>
  </div>
</div>
