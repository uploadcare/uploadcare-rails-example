<div class="uc-page-header">
  <h1>Webhook ID <%= @webhook.id %> info</h1>
  <div class="uc-action-group">
    <%= link_to 'Edit', edit_webhook_path(@webhook.id), class: 'uc-button uc-button-sm uc-button-secondary' %>
    <%= button_to 'Delete', delete_webhook_path(target_url: @webhook.target_url), method: :delete, class: 'uc-button uc-button-sm uc-button-danger', form_class: "inline-block" %>
  </div>
</div>

<div class="uc-card">
  <ul class="uc-list">
    <li class="uc-list-item">
      <strong>ID</strong>: <%= @webhook.id %>
    </li>
    <li class="uc-list-item">
      <strong>Created at</strong>: <%= format_date(@webhook.created) %>
    </li>
    <li class="uc-list-item">
      <strong>Updated at</strong>: <%= format_date(@webhook.updated) %>
    </li>
    <li class="uc-list-item">
      <strong>Event</strong>: <%= @webhook.event %>
    </li>
    <li class="uc-list-item">
      <strong>Target Url</strong>: <%= @webhook.target_url %>
    </li>
    <li class="uc-list-item">
      <strong>Project</strong>: <%= @webhook.project %>
    </li>
    <li class="uc-list-item">
      <% if @webhook.is_active %>
        <div class="uc-badge uc-badge-info">Active</div>
      <% else %>
        <div class="uc-badge uc-badge-secondary">Not active</div>
      <% end %>
    </li>
  </ul>
</div>
